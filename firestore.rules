rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function isCampaignMember(campaignId) {
      return isAuthenticated() && (
        // Check if campaign ID is in user's profile
        (exists(/databases/$(database)/documents/users/$(getUserId())) &&
          campaignId in get(/databases/$(database)/documents/users/$(getUserId())).data.campaigns) ||
        // Fallback: check campaign document directly
        (exists(/databases/$(database)/documents/campaigns/$(campaignId)) &&
          getUserId() in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.members)
      );
    }

    function isCampaignOwner(campaignId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/campaigns/$(campaignId)) &&
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == getUserId()) ||
        (exists(/databases/$(database)/documents/campaigns/$(campaignId)/metadata) &&
          get(/databases/$(database)/documents/campaigns/$(campaignId)/metadata).data.ownerId == getUserId())
      );
    }

    function isSessionOwner(campaignId, sessionId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/campaigns/$(campaignId)/audioSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)/audioSessions/$(sessionId)).data.ownerId == getUserId();
    }

    function isCharacterOwner(characterId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.userId == getUserId();
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(getUserId())) &&
        get(/databases/$(database)/documents/users/$(getUserId())).data.admin == true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Users can write to their own profile
      allow write: if isAuthenticated() && getUserId() == userId;

      // Allow adding campaigns to other users' profiles (for invitations)
      // Security is enforced by campaign document rules - users can only read campaigns they're members of
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campaigns', 'updatedAt']) &&
        // Ensure campaigns array only grows (no removals)
        request.resource.data.campaigns.hasAll(resource.data.get('campaigns', []));
    }

    // Characters — top-level collection, publicly readable
    match /characters/{characterId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == getUserId();
      allow update, delete: if isAuthenticated() && resource.data.userId == getUserId();

      match /versions/{versionId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          get(/databases/$(database)/documents/characters/$(characterId)).data.userId == getUserId();
        allow update: if isAuthenticated() &&
          get(/databases/$(database)/documents/characters/$(characterId)).data.userId == getUserId();
        // Versions are kept: the owner switches between them instead of removing one.
        allow delete: if false;
      }

      match /images/{imageId} {
        allow read: if true;
        allow create, delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/characters/$(characterId)).data.userId == getUserId();
        allow update: if false; // Immutable
      }

      // Conversations with The Sidekick. A character is public, its conversations are
      // the owner's alone. The backend (characterChat) writes them; the owner can only
      // rename a conversation here. Deleting goes through deleteCharacterChat.
      match /chats/{chatId} {
        allow read: if isCharacterOwner(characterId);
        allow update: if isCharacterOwner(characterId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'titleSource']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 80 &&
          request.resource.data.titleSource == 'user';
        allow create, delete: if false;

        match /messages/{messageId} {
          allow read: if isCharacterOwner(characterId);
          // Cancel a running character update; the worker then does not save the version it is making.
          allow update: if isCharacterOwner(characterId) &&
            resource.data.kind == 'characterUpdate' &&
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'cancelled';
          allow create, delete: if false;
        }
      }
    }

    // Campaigns
    match /campaigns/{campaignId} {
      allow read: if isCampaignMember(campaignId) ||
        !exists(/databases/$(database)/documents/campaigns/$(campaignId));
      allow create: if isAuthenticated() && request.resource.data.ownerId == getUserId();
      allow update: if isCampaignOwner(campaignId);
      allow delete: if isCampaignOwner(campaignId);
    }

    // Legacy campaign metadata (read-only during migration)
    match /campaigns/{campaignId}/metadata {
      allow read: if isCampaignMember(campaignId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == getUserId();
      allow update: if isCampaignOwner(campaignId);
      allow delete: if isCampaignOwner(campaignId);
    }

    // Audio sessions in campaigns
    match /campaigns/{campaignId}/audioSessions/{sessionId} {
      allow read: if isCampaignMember(campaignId);

      allow create: if isCampaignMember(campaignId) &&
        request.resource.data.ownerId == getUserId();

      // The session owner may change anything. Every other member may save
      // corrections, and may rewrite the story of a finished session by hand:
      // that is one version further each time, signed with their own uid.
      allow update: if isCampaignMember(campaignId) && (
        isSessionOwner(campaignId, sessionId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userCorrections',
          'correctionsUpdatedAt',
          'updatedAt'
        ]) ||
        (
          resource.data.status == 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content',
            'storyEditedAt',
            'storyEditedBy',
            'storyEditedByName',
            'storyRegenerationCount',
            'updatedAt'
          ]) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 300000 &&
          request.resource.data.storyEditedAt is string &&
          request.resource.data.storyEditedBy == getUserId() &&
          request.resource.data.storyEditedByName is string &&
          request.resource.data.storyEditedByName.size() <= 100 &&
          request.resource.data.storyRegenerationCount ==
            resource.data.get('storyRegenerationCount', 1) + 1
        )
      );

      allow delete: if isSessionOwner(campaignId, sessionId);
    }

    // Subcollections of audio sessions
    match /campaigns/{campaignId}/audioSessions/{sessionId}/{subcollection=**} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isSessionOwner(campaignId, sessionId);
    }

    // The lock on a story: the member who is editing it right now. One document
    // per story. A member takes it when it is free, keeps it by refreshing it, and
    // can take it over only once its holder has not refreshed it for 90 seconds
    // (LOCK_EXPIRES_MS in story-edit-lock.service.ts). Only the holder removes it.
    match /campaigns/{campaignId}/storyEditors/{target} {
      function isOwnFreshLock() {
        return request.resource.data.keys().hasOnly(['id', 'target', 'uid', 'name', 'updatedAt']) &&
          request.resource.data.uid == getUserId() &&
          request.resource.data.target == target &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.updatedAt == request.time;
      }

      allow read: if isCampaignMember(campaignId);
      allow create: if isCampaignMember(campaignId) && isOwnFreshLock();
      allow update: if isCampaignMember(campaignId) && isOwnFreshLock() && (
        resource.data.uid == getUserId() ||
        resource.data.updatedAt < request.time - duration.value(90, 's')
      );
      allow delete: if isAuthenticated() && resource.data.uid == getUserId();
    }

    // Campaign story versions (ticket #69) — members read, the backend writes.
    // Every member may improve the newest finished version by hand (title and
    // text): that version goes along when the next one is written.
    match /campaigns/{campaignId}/campaignStories/{versionId} {
      allow read: if isCampaignMember(campaignId);
      allow update: if isCampaignMember(campaignId) &&
        resource.data.status == 'completed' &&
        resource.data.version ==
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.campaignStory.latestCompletedVersion &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'content',
          'wordCount',
          'editedAt',
          'editedBy',
          'editedByName'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 200000 &&
        request.resource.data.wordCount is int &&
        request.resource.data.editedAt is timestamp &&
        request.resource.data.editedBy == getUserId() &&
        request.resource.data.editedByName is string &&
        request.resource.data.editedByName.size() <= 100;
      allow create, delete: if false;
    }

    // Public podcast share links — anyone with the (unguessable) id can read one,
    // listing is not allowed and only the backend (createPodcastShare) writes.
    match /podcastShares/{shareId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Settings collection - read-only for authenticated users
    match /settings/{document} {
      allow read: if isAuthenticated();
      // Admin-only writes
      allow write: if isAdmin();
    }
  }
}
