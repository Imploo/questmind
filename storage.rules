rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isCampaignMember(campaignId) {
      return request.auth != null && (
        // Check if campaign ID is in user's profile (matches Firestore rules primary check)
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          campaignId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.campaigns) ||
        // Fallback: check campaign document members directly
        (firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data.members)
      );
    }

    function isAudioSessionOwner(campaignId, sessionId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/audioSessions/$(sessionId)).data.ownerId == request.auth.uid;
    }

    function isCampaignOwner(campaignId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
    }

    // Voice intro per campaign (ticket #68): the group introducing themselves,
    // used as a voice reference during transcription. The processed file is written by the
    // backend (processVoiceIntro); the owner can remove it, members can listen.
    match /campaigns/{campaignId}/voice-intro/{filename} {
      allow read: if isCampaignMember(campaignId);
      allow write: if false;
      allow delete: if isCampaignOwner(campaignId);
    }

    // Uploaded voice-intro source (original, or browser-compressed WAV) awaiting processing;
    // the backend removes it afterwards. 500 MB covers a WAV that couldn't be compressed in the browser. Delete is a separate rule: request.resource is null
    // on delete, so the size/type checks can't apply.
    match /campaigns/{campaignId}/voice-intro/source/{filename} {
      allow create, update: if isCampaignOwner(campaignId)
                            && request.resource.size < 500 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if isCampaignOwner(campaignId);
    }

    // Audio files (campaigns)
    // Write only requires authentication — session IDs are UUIDs (unguessable) and the
    // backend validates campaign membership before processing. Cross-service Firestore
    // reads in Storage rules are unreliable for write-gating.
    // The session's processed recording (compressed + normalized MP3), written by the backend
    // only, so it can be replayed and re-transcribed. Delete is limited to the session owner.
    match /campaigns/{campaignId}/audio/{sessionId}/{filename} {
      allow read: if isCampaignMember(campaignId);
      allow write: if false;
      allow delete: if isAudioSessionOwner(campaignId, sessionId);
    }

    // Uploaded source files (original M4A/MP3, or browser-compressed WAV) awaiting backend
    // processing; the backend removes them once the recording is stored. 4 GB covers a long
    // WAV that couldn't be compressed in the browser.
    match /campaigns/{campaignId}/audio/{sessionId}/source/{filename} {
      allow read: if isCampaignMember(campaignId);
      allow create, update: if request.auth != null
                            && request.resource.size < 4 * 1024 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if isAudioSessionOwner(campaignId, sessionId);
    }

    // Podcast files (campaigns)
    match /campaigns/{campaignId}/podcasts/{sessionId}/{filename} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isCampaignMember(campaignId)
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType == 'audio/mpeg'
                       || request.resource.contentType == 'audio/mp3'
                       || request.resource.contentType == 'audio/m4a');
    }

    // Campaign story podcasts (ticket #69) — members listen, only the backend writes
    match /campaigns/{campaignId}/campaign-story-podcasts/{storyVersion}/{filename} {
      allow read: if isCampaignMember(campaignId);
      allow write: if false;
    }

    // Generated character images — owner can delete, anyone can read via download token
    match /images/{characterId}/{filename} {
      allow read: if true;
      allow delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/characters/$(characterId)).data.userId == request.auth.uid;
      // Write handled by backend only
    }

    // Chat images per character
    match /chat/{characterId}/{filename} {
      allow read: if request.auth != null;
      // Write handled by backend only
    }

    // Chat images (fallback for characters without ID)
    match /chat-images/{filename} {
      allow read: if request.auth != null;
      // Write handled by backend only
    }
  }
}
